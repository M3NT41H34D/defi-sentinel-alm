# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - DEFI SENTINEL & ALM MANAGER
# Copie este arquivo para .env e preencha com seus dados locais.
# NUNCA comite o seu arquivo .env no GitHub!
# ==============================================================================

# Modo Operacional: True = Paper Trading / Simulação | False = Fogo Real
MODO_PAPER_POOL=True

# Parâmetros da Carteira (Nunca coloque chaves privadas aqui)
CARTEIRA_OPERACIONAL=0x0000000000000000000000000000000000000000
NFT_ID_POSICAO=0
CAPITAL_ALOCADO_USD=1000.00

# Faixa Inicial da Posição Uniswap v3 (WBTC/WETH Ratio)
TICK_MIN_CONFIG=264620
TICK_MAX_CONFIG=266620
FAIXA_MIN_RATIO=31.00
FAIXA_MAX_RATIO=38.00

# Parâmetros de Risco do Sentinela
QUEDA_DISPARO_HEDGE_PCT=0.035
INTERVALO_SENTINELA_SEG=5

# RPCs Arbitrum (Opcional - Usará endpoints públicos se omitido)
ARBITRUM_RPC_1=https://arb1.arbitrum.io/rpc
ARBITRUM_RPC_2=https://1rpc.io/arb
ARBITRUM_RPC_3=https://arbitrum-one.publicnode.com
